# Скопируйте в server/.env и заполните. Сам .env в git не попадает.

# Вариант 1 (Render и т.п.): полный адрес БД
DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=false   # выключить SSL, если БД без него

# Вариант 2 (docker-compose / локально)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=sss_db

# Обязательно задайте в продакшене: любая длинная случайная строка
JWT_SECRET=

# Адреса фронтенда через запятую (CORS и сокеты). Пусто = разрешить любой
CLIENT_ORIGIN=https://skrupa4.github.io

PORT=5000

# Кто получает админ-панель (ник или хэндл, через запятую). Проверка идёт на сервере.
ADMIN_USERNAMES=skrupa4

# Оплата монет через ЮKassa (без ключей покупка отключена, остальное работает).
# В кабинете ЮKassa: HTTP-уведомления -> https://<ваш-сервер>/api/coins/webhook (событие payment.succeeded)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Push-уведомления на телефон. Ключи VAPID создаются сервером сами и хранятся в БД.
# Контакт для push-сервисов Google/Apple (почта владельца сайта):
# VAPID_SUBJECT=mailto:you@example.com

# Подтверждение почты кодом при регистрации и смене почты.
# Нужен ключ ОДНОГО сервиса (Brevo или Resend) и адрес отправителя. Без них код не требуется.
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM=noreply@вашдомен.ru
# MAIL_FROM_NAME=SSS
